# ==============================================================================
#  my_environment — bash entry point
#  Sourced from ~/.bashrc. Everything interactive lives in bash/*.sh
# ==============================================================================

# Non-interactive shells (scp, rsync, scripts) must stay silent and fast.
case $- in *i*) ;; *) return ;; esac

: "${MY_ENV_ROOT:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"}"
export MY_ENV_ROOT

for _mod in env colors history options aliases functions prompt integrations; do
    [[ -r "$MY_ENV_ROOT/bash/$_mod.sh" ]] && source "$MY_ENV_ROOT/bash/$_mod.sh"
done
unset _mod

# Machine-specific overrides, never committed.
[[ -r "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"
[[ -r "$MY_ENV_ROOT/bash/local.sh" ]] && source "$MY_ENV_ROOT/bash/local.sh"
